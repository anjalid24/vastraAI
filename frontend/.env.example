# Base URL for the Vastra AI backend REST API.
# Leave empty to use the Vite dev-server proxy (recommended in development),
# which forwards /api and /health to the Express server on localhost:5000.
# Set an absolute URL (e.g. https://api.vastra.ai) for production builds.
VITE_API_BASE_URL=

# Where the Express backend runs, used by the Vite dev proxy only.
VITE_BACKEND_URL=http://localhost:5000
