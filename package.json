{
  "name": "vastra-ai-backend",
  "version": "1.0.0",
  "description": "Vastra AI Backend - AI-powered textile ecosystem for Indian heritage",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/seed.js",
    "seed:admin": "node src/seeders/adminSeeder.js",
    "logs": "tail -f logs/$(date +%Y-%m-%d).log",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "axios": "^1.3.6",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.3",
    "multer": "^2.5.0",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^10.6.1",
    "redis": "^4.6.5",
    "winston": "^3.8.2",
    "xss-clean": "^0.1.1"
  },
  "devDependencies": {
    "nodemon": "3.1.11"
  },
  "overrides": {
    "cloudinary": "$cloudinary",
    "qs": "^6.17.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
