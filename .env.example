# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/vastra_ai

# ── Authentication (JWT) ──────────────────────────────────
# Use a long, random string in real environments.
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins, or * to allow all.
CORS_ORIGIN=*

# ── AI Service (Django REST Framework) ────────────────────
# Base URL of the separate AI image-generation service this
# backend will call over REST. Placeholder for upcoming modules.
AI_SERVICE_URL=http://127.0.0.1:8000
